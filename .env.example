# ── Model ────────────────────────────────────────────────────────────────────
# Server-side only. Never expose with a NEXT_PUBLIC_ prefix: the widget runs on
# other companies' pages, so a public key would be readable by every visitor.
GEMINI_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for feed ingestion and usage metering (bypasses tenant RLS).
SUPABASE_SERVICE_ROLE_KEY=

# ── Feed ingestion ───────────────────────────────────────────────────────────
# Shared secret for POST /api/feed/sync. Rotate per tenant in production by
# using tenants.feed_secret instead; this is the fallback for local dev.
FEED_SYNC_SECRET=

# ── Runtime ──────────────────────────────────────────────────────────────────
# Public origin of THIS deployment, used by the loader to build the iframe URL.
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3000
# Local development without a database: serve tenants from ./tenants/*.json.
# Never set this in production.
ROVENA_LOCAL_TENANTS=1
